{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "express"]
  },
  "include": [
    "./**/*.js",
    "./**/*.ts",
    "./**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "uploads",
    "tmp",
    "dist"
  ]
}
